<?xml version="1.0" encoding="utf-8"?><androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search AI, Coding, or Design courses…"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Featured Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Features"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ai_banner"
                        android:contentDescription="AI Banner"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/programming_banner"
                        android:contentDescription="Programming Banner"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cyber_banner"
                        android:contentDescription="Cyber Banner"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/design_banner"
                        android:contentDescription="Design Banner"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- =============================================================== -->
        <!-- START OF REVISED EXPANDABLE CATEGORIES SECTION                  -->
        <!-- =============================================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Top Categories"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <LinearLayout
            android:id="@+id/category_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="16dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/category_header_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/explore_categories_banner"
                android:contentDescription="Click to explore categories"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/hidden_categories_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:visibility="gone"
                tools:visibility="visible">
                <TextView
                    android:id="@+id/category_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Artificial Intelligence"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
                <TextView
                    android:id="@+id/category_programming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. All Programmings"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
                <TextView
                    android:id="@+id/category_cybersecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Cybersecurity"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
                <TextView
                    android:id="@+id/category_designs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Designs"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>
        <!-- =============================================================== -->
        <!-- END OF REVISED EXPANDABLE CATEGORIES SECTION                    -->
        <!-- =============================================================== -->

        <!-- =============================================================== -->
        <!-- START OF NEW "POWERS OF AI" BANNER                         -->
        <!-- =============================================================== -->


        <androidx.cardview.widget.CardView
            android:id="@+id/powers_of_ai_banner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Powers of AI Banner"
                android:scaleType="centerCrop"
                android:src="@drawable/recommended_for_you" />

        </androidx.cardview.widget.CardView>
        <!-- =============================================================== -->
        <!-- END OF NEW "POWERS OF AI" BANNER                           -->
        <!-- =============================================================== -->

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
