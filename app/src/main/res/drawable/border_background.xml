<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">    <!-- This is the stroke (the border) -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" /> <!-- A light grey color for the border -->

    <!-- This is the background color of the shape -->
    <solid
        android:color="@android:color/white" />

    <!-- This adds rounded corners -->
    <corners
        android:radius="8dp" />

</shape>
