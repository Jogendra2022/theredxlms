<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TheRedxLMS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- You can add theme-specific items here -->
    </style>
    <style name="Widget.TheRedxLMS.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item> <!-- A good, tappable height -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">12dp</item> <!-- Rounded corners -->
        <item name="android:elevation">4dp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall</item>
    </style>

    <!-- ADD THIS STYLE FOR THE TAB LAYOUT DOTS -->
    <style name="OnboardingTabStyle" parent="Widget.Design.TabLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- This margin will add space between the dots -->
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>
    <style name="Theme.TheRedxLMS.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Make it fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Set the background to a clean white -->
        <item name="android:windowBackground">@color/redx_white</item>
    </style>
    <style name="Widget.TheRedxLMS.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
</resources>
